#!/bin/sh
# ghidra-decompile: Ghidra sem janela, para os agentes.
#   ghidra-decompile BINARIO                 decompila as funções (até GHIDRA_LIMIT, padrão 200)
#   ghidra-decompile BINARIO main 0x401000   só estas (nome ou endereço)
#   ghidra-decompile --list BINARIO          lista funções e importações
# A análise fica guardada em ~/ghidra-projetos (a segunda chamada no mesmo binário é rápida).
# Memória: GHIDRA_MAXMEM (padrão 768M).
set -e
script=Decompile.java
if [ "$1" = "--list" ]; then script=ListFunctions.java; shift; fi
if [ -z "$1" ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0; fi
bin=$(readlink -f "$1"); shift
[ -f "$bin" ] || { echo "arquivo não encontrado: $bin" >&2; exit 1; }
proj="$HOME/ghidra-projetos"; mkdir -p "$proj"
name=$(printf '%s' "$bin" | sha1sum | cut -c1-12)
out=$(mktemp); export GHIDRA_OUT="$out"
export MAXMEM="${GHIDRA_MAXMEM:-768M}"
if [ -d "$proj/$name.rep" ]; then
  /opt/ghidra/support/analyzeHeadless "$proj" "$name" -process "$(basename "$bin")" -noanalysis -readOnly \
    -scriptPath /opt/studio-ghidra -postScript "$script" "$@" >"$out.log" 2>&1 || { tail -30 "$out.log" >&2; exit 1; }
else
  /opt/ghidra/support/analyzeHeadless "$proj" "$name" -import "$bin" \
    -scriptPath /opt/studio-ghidra -postScript "$script" "$@" >"$out.log" 2>&1 || { tail -30 "$out.log" >&2; exit 1; }
fi
cat "$out"; rm -f "$out" "$out.log"
