# Studio de cada usuário na nuvem (o mesmo llama-studio, sem llama.cpp nem nada do PC).
# Compila nativo na arquitetura do servidor (ARM64 ou x86_64).
FROM rust:1-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock build.rs ./
COPY src src
COPY ui ui
COPY assets assets
RUN cargo build --release --locked --no-default-features && strip target/release/llama-studio

FROM debian:bookworm-slim
# ferramentas que os agentes usam na pasta da nuvem (engenharia reversa estática incluída)
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates libssl3 python3 python3-pip python3-venv git curl wget unzip xz-utils zip file \
      binutils binutils-multiarch procps less jq nodejs npm ripgrep fd-find \
    && pip3 install --no-cache-dir --break-system-packages pefile capstone lief pyelftools \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -u 1000 -m -d /data/home studio
COPY --from=build /src/target/release/llama-studio /usr/local/bin/llama-studio
ENV STUDIO_CLOUD=1 STUDIO_DIR=/data STUDIO_PORT=8080 STUDIO_NO_OPEN=1 HOME=/data/home
USER 1000:1000
WORKDIR /data
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/llama-studio"]
