# Studio de cada usuário na nuvem (o mesmo llama-studio, sem llama.cpp nem nada do PC).
# Compila nativo na arquitetura do servidor (ARM64 ou x86_64).
FROM rust:1-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock build.rs ./
COPY src src
COPY ui ui
COPY assets assets
RUN cargo build --release --locked --no-default-features && strip target/release/llama-studio

# Ghidra (análise estática com o PC desligado). No ARM64 o decompilador nativo é compilado aqui (support/gradle/
# gradlew buildNatives; vai para build/os/linux_arm_64, que o Ghidra prefere), se a versão baixada não trouxer pronto. GHIDRA_URL fixa uma versão; vazio = a última publicada.
FROM debian:trixie-slim AS ghidra
ARG GHIDRA_URL=
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip jq openjdk-21-jdk-headless build-essential \
    && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    url="${GHIDRA_URL:-$(curl -fsSL https://api.github.com/repos/NationalSecurityAgency/ghidra/releases/latest | jq -r '.assets[] | select(.name | endswith(".zip")) | .browser_download_url' | head -1)}"; \
    echo "Ghidra: $url"; curl -fsSL -o /tmp/g.zip "$url"; unzip -q /tmp/g.zip -d /opt; rm /tmp/g.zip; mv /opt/ghidra_* /opt/ghidra; \
    arch=$(uname -m); \
    if [ "$arch" = "aarch64" ] && [ ! -e /opt/ghidra/Ghidra/Features/Decompiler/os/linux_arm_64/decompile ]; then \
      cd /opt/ghidra/support/gradle && ./gradlew --no-daemon buildNatives; \
      rm -rf /root/.gradle /opt/ghidra/support/gradle/.gradle; \
    fi; \
    find /opt/ghidra/Ghidra/Features/Decompiler -name decompile -path "*linux*" | grep -q . || { echo "decompilador nativo não encontrado"; exit 1; }; \
    du -sh /opt/ghidra; \
    # enxuga: o que o modo sem janela não usa (documentação, código-fonte, servidor, depurador, extensões
    # opcionais, binários de outros sistemas e processadores raros)
    cd /opt/ghidra; \
    rm -rf docs server Extensions Ghidra/Extensions Ghidra/Debug support/gradle; \
    find . -name "*-src.zip" -delete; \
    find Ghidra -type d -path "*/os/*" \( -name "win_*" -o -name "mac_*" -o -name "freebsd_*" \) -prune -exec rm -rf {} +; \
    if [ "$arch" = "aarch64" ]; then find Ghidra -type d -name linux_x86_64 -prune -exec rm -rf {} +; else find Ghidra -type d -name linux_arm_64 -prune -exec rm -rf {} +; fi; \
    keep=" x86 ARM AARCH64 MIPS PowerPC RISCV JVM Dalvik DATA 8051 68000 SuperH Atmel tricore Xtensa V850 "; \
    for d in Ghidra/Processors/*; do n=$(basename "$d"); case "$keep" in *" $n "*) ;; *) rm -rf "$d";; esac; done; \
    find Ghidra -type f -path "*/os/linux_*/*" -exec strip --strip-unneeded {} + 2>/dev/null || true; \
    du -sh /opt/ghidra

FROM debian:trixie-slim
# ferramentas que os agentes usam na pasta da nuvem (engenharia reversa estática incluída)
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates libssl3t64 python3 python3-pip python3-venv git curl wget unzip xz-utils zip file \
      binutils binutils-multiarch procps less jq nodejs npm ripgrep fd-find openjdk-21-jre-headless \
      chromium fonts-dejavu-core \
    && pip3 install --no-cache-dir --break-system-packages pefile capstone lief pyelftools \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -u 1000 -m -d /data/home studio
COPY --from=ghidra /opt/ghidra /opt/ghidra
COPY cloud/ghidra/Decompile.java cloud/ghidra/ListFunctions.java /opt/studio-ghidra/
COPY --chmod=755 cloud/ghidra/ghidra-decompile /usr/local/bin/ghidra-decompile
COPY --from=build /src/target/release/llama-studio /usr/local/bin/llama-studio
ENV STUDIO_BROWSER=/usr/bin/chromium STUDIO_CLOUD=1 STUDIO_DIR=/data STUDIO_PORT=8080 STUDIO_NO_OPEN=1 HOME=/data/home GHIDRA_INSTALL_DIR=/opt/ghidra
USER 1000:1000
WORKDIR /data
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/llama-studio"]
