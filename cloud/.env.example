# Porta da central no servidor (o seu proxy aponta para cá).
# 127.0.0.1 = só a própria máquina; 172.17.0.1 = também contêineres (NPM em Docker); 0.0.0.0 = toda a rede
HUB_LISTEN=127.0.0.1
HUB_PORT=8700
# Seu domínio (o DNS dele já aponta para este servidor)
DOMAIN=studio.seudominio.com
# Onde ficam o banco e as pastas dos usuários
HUB_DATA=/srv/studio-hub
# open = cadastro aberto; closed = só quem já tem conta
HUB_SIGNUP=open
HUB_SIGNUPS_PER_IP=3
# Limites de cada studio na nuvem
# 2g recomendado se for usar o Ghidra na nuvem
HUB_MEM=2g
HUB_CPUS=1
HUB_DISK_MB=2048
HUB_IDLE_MIN=20
HUB_MAX_RUNNING=8
# Vazio = qualquer site público por HTTPS; ou uma lista: api.groq.com,openrouter.ai,github.com,pypi.org
HUB_ALLOW=
# Imagens (prontas no GitHub, ARM64 e x86_64). Para compilar no servidor, veja o README.
# HUB_IMAGE=ghcr.io/locdown2311/llama-studio-cloud:latest
# HUB_HUB_IMAGE=ghcr.io/locdown2311/studio-hub:latest
# Com o Nginx Proxy Manager: a rede do contêiner dele (docker-compose.npm.yml)
NPM_NETWORK=npm_default
