# studio-hub: a central (contas, PC vinculado, um contêiner por usuário).
FROM rust:1-bookworm AS build
WORKDIR /src
COPY hub/Cargo.toml hub/Cargo.lock ./
COPY hub/src src
COPY hub/assets assets
RUN cargo build --release --locked && strip target/release/studio-hub

FROM docker:28-cli AS cli

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=build /src/target/release/studio-hub /usr/local/bin/studio-hub
EXPOSE 8700 3128
ENTRYPOINT ["/usr/local/bin/studio-hub"]
